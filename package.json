{
  "name": "orca-change-review",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "publish:github": "bash scripts/publish-github.sh",
    "check:changes": "node scripts/check-revisions.mjs",
    "record:orca": "node scripts/record-orca-variants.mjs",
    "import:orca": "node scripts/import-orca-media.mjs",
    "predev": "npm run import:orca",
    "dev": "vite --host 0.0.0.0 --port 3100",
    "prebuild": "npm run import:orca",
    "build": "node scripts/build-site.mjs",
    "start": "vite preview --host 0.0.0.0 --port 3100",
    "deploy:local": "node scripts/deploy-local.mjs",
    "version:set": "node scripts/version.mjs",
    "test:preview": "node --test lib/local-preview.test.mjs",
    "test:wiki": "node --test lib/wiki-records.test.mjs",
    "test": "node --test lib/*.test.mjs scripts/*.test.mjs"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/server-renderer": "3.5.43",
    "vite": "7.3.1"
  }
}
